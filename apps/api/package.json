{
  "name": "@hall-of-fame/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hall-of-fame/contracts": "workspace:*",
    "@hall-of-fame/deepseek-client": "workspace:*",
    "@hall-of-fame/domain": "workspace:*",
    "@hall-of-fame/prompt-kit": "workspace:*",
    "@hall-of-fame/runtime-env": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.4.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.0"
  }
}
