COMPOSE_PROJECT_NAME=hall-of-fame-local
NODE_ENV=production

WEB_DOMAIN=localhost
API_DOMAIN=api.localhost
CADDY_EMAIL=local@example.com
CADDY_AUTO_HTTPS=off
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443

LOCAL_API_PORT=13000
LOCAL_WORKER_PORT=13001
LOCAL_H5_PORT=13100
LOCAL_POSTGRES_PORT=15432
LOCAL_MINIO_API_PORT=19000
LOCAL_MINIO_CONSOLE_PORT=19001

HOF_API_IMAGE=hof-api:local
HOF_WORKER_IMAGE=hof-worker:local
HOF_H5_IMAGE=hof-h5:local
HOF_MIGRATE_IMAGE=hof-migrate:local

PUBLIC_WEB_BASE_URL=http://localhost:8080
PUBLIC_API_BASE_URL=http://api.localhost:8080
APP_BASE_URL=
WORKER_BASE_URL=http://worker:3001
RUN_DB_BOOTSTRAP_ON_STARTUP=true

DATABASE_URL=postgresql://hof:hof@postgres:5432/hall_of_fame
POSTGRES_PASSWORD=
REDIS_URL=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_BUCKET=hall-of-fame-local
S3_ACCESS_KEY_ID=hof_minio
S3_SECRET_ACCESS_KEY=hof_minio_secret
S3_REGION=us-east-1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

WECHAT_APP_ID=
WECHAT_APP_SECRET=
