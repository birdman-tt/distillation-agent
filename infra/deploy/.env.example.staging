COMPOSE_PROJECT_NAME=hall-of-fame-staging
NODE_ENV=production

WEB_DOMAIN=staging.example.com
API_DOMAIN=api-staging.example.com
CADDY_EMAIL=ops@example.com
CADDY_AUTO_HTTPS=on
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

HOF_API_IMAGE=ghcr.io/example/hall-of-fame-api:staging-latest
HOF_WORKER_IMAGE=ghcr.io/example/hall-of-fame-worker:staging-latest
HOF_H5_IMAGE=ghcr.io/example/hall-of-fame-h5:staging-latest
HOF_MIGRATE_IMAGE=ghcr.io/example/hall-of-fame-migrate:staging-latest

PUBLIC_WEB_BASE_URL=https://staging.example.com
PUBLIC_API_BASE_URL=https://api-staging.example.com
APP_BASE_URL=
WORKER_BASE_URL=http://worker:3001
RUN_DB_BOOTSTRAP_ON_STARTUP=false

DATABASE_URL=postgresql://user:password@db.example.com:5432/hall_of_fame
POSTGRES_PASSWORD=replace-me-if-using-supabase-pooler
REDIS_URL=

S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://cdn.example.com
S3_BUCKET=hall-of-fame-staging
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=ap-singapore

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

WECHAT_APP_ID=replace-me
WECHAT_APP_SECRET=replace-me
