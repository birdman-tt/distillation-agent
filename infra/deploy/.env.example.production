COMPOSE_PROJECT_NAME=hall-of-fame-production
NODE_ENV=production

WEB_DOMAIN=www.example.com
API_DOMAIN=api.example.com
CADDY_EMAIL=ops@example.com
CADDY_AUTO_HTTPS=on
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

HOF_API_IMAGE=ghcr.io/example/hall-of-fame-api:prod-latest
HOF_WORKER_IMAGE=ghcr.io/example/hall-of-fame-worker:prod-latest
HOF_H5_IMAGE=ghcr.io/example/hall-of-fame-h5:prod-latest
HOF_MIGRATE_IMAGE=ghcr.io/example/hall-of-fame-migrate:prod-latest

PUBLIC_WEB_BASE_URL=https://www.example.com
PUBLIC_API_BASE_URL=https://api.example.com
APP_BASE_URL=
WORKER_BASE_URL=http://worker:3001
RUN_DB_BOOTSTRAP_ON_STARTUP=false

DATABASE_URL=postgresql://user:password@db.example.com:5432/hall_of_fame
POSTGRES_PASSWORD=replace-me-if-using-supabase-pooler
REDIS_URL=

S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://cdn.example.com
S3_BUCKET=hall-of-fame
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=ap-singapore

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

MINIMAX_API_KEY=replace-me
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_PLANNER_MODEL=MiniMax-M2.7
CHAT_PLANNER_ENABLED=false
CHAT_PLANNER_MODE=decision
CHAT_FAST_PLANNER_PROVIDER=deepseek
CHAT_FAST_PLANNER_MODEL=deepseek-v4-flash
CHAT_PLANNER_TIMEOUT_MS=2000
CHAT_RUNTIME_TIME_ZONE=Asia/Shanghai

KIMI_API_KEY=replace-me
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
KIMI_WEB_SEARCH_ENABLED=false
KIMI_WEB_SEARCH_FORMULA_URI=moonshot/web-search:latest
KIMI_TIMEOUT_MS=12000
KIMI_MAX_TOOL_CALLS=3

EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
QWEN_API_KEY=replace-me
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MESSAGE_EMBEDDING_ENABLED=true
PERSONA_EMBEDDING_ENABLED=true
CHAT_VECTOR_RETRIEVAL_ENABLED=true
PERSONA_VECTOR_RETRIEVAL_ENABLED=true
CHAT_RETRIEVAL_CHAT_TOP_K=8
CHAT_RETRIEVAL_CHAT_VECTOR_MIN_SCORE=0.28
CHAT_RETRIEVAL_MAX_CONTEXT_TOKENS=40000
CHAT_RETRIEVAL_RECENT_TURNS=12
CHAT_RETRIEVAL_PERSONA_TOP_K=8
CHAT_RETRIEVAL_PERSONA_VECTOR_MIN_SCORE=0.28

WECHAT_APP_ID=replace-me
WECHAT_APP_SECRET=replace-me
