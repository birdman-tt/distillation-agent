NODE_ENV=development
APP_PORT=3000
WORKER_PORT=3001
H5_PORT=3100
APP_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000
PUBLIC_WEB_BASE_URL=http://localhost:3100
WORKER_BASE_URL=http://localhost:3001

DATABASE_URL=postgresql://hof:hof@localhost:5432/hall_of_fame
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=hall-of-fame
S3_ACCESS_KEY_ID=hof_minio
S3_SECRET_ACCESS_KEY=hof_minio_secret
S3_REGION=us-east-1

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
# Optional: enabled|disabled. Empty disables thinking for deepseek-v4 structured JSON replies.
DEEPSEEK_CHAT_THINKING=
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_PLANNER_MODEL=MiniMax-M2.7
CHAT_PLANNER_ENABLED=false
CHAT_PLANNER_MODE=decision
CHAT_FAST_PLANNER_PROVIDER=deepseek
CHAT_FAST_PLANNER_MODEL=deepseek-v4-flash
CHAT_PLANNER_TIMEOUT_MS=2000
CHAT_RUNTIME_TIME_ZONE=Asia/Shanghai

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_WEB_SEARCH_ENABLED=false
KIMI_WEB_SEARCH_FORMULA_URI=moonshot/web-search:latest
KIMI_TIMEOUT_MS=12000
KIMI_MAX_TOOL_CALLS=3
CHAT_KIMI_RESEARCH_TIMEOUT_MS=30000

# One-click distill.
# Development defaults: worker polling is on, and Kimi discovery is on when KIMI_API_KEY + KIMI_WEB_SEARCH_ENABLED=true are configured.
# Production defaults: both remain opt-in unless explicitly set to true.
PERSONA_DISTILL_POLLING_ENABLED=
PERSONA_DISTILL_KIMI_DISCOVERY_ENABLED=
PERSONA_DISTILL_SYNTHETIC_DISCOVERY_ENABLED=false
# Legacy synchronous persona manage endpoints are only for local debugging.
# Unset means enabled outside production and disabled in production.
LEGACY_SYNC_PERSONA_MANAGE_ENABLED=

EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_QUERY_EMBEDDING_TIMEOUT_MS=800
CHAT_MESSAGE_EMBEDDING_ENABLED=true
PERSONA_EMBEDDING_ENABLED=true
CHAT_VECTOR_RETRIEVAL_ENABLED=true
PERSONA_VECTOR_RETRIEVAL_ENABLED=true
CHAT_RETRIEVAL_CHAT_TOP_K=8
CHAT_RETRIEVAL_CHAT_VECTOR_MIN_SCORE=0.28
CHAT_RETRIEVAL_MAX_CONTEXT_TOKENS=40000
CHAT_RETRIEVAL_RECENT_TURNS=12
CHAT_RETRIEVAL_PERSONA_TOP_K=8
CHAT_RETRIEVAL_PERSONA_VECTOR_MIN_SCORE=0.28

CHAT_TRACE_CAPTURE_LEVEL=full
CHAT_TRACE_INTERNAL_ENABLED=true
CHAT_TRACE_INTERNAL_TOKEN=

WECHAT_APP_ID=replace-me
WECHAT_APP_SECRET=replace-me
